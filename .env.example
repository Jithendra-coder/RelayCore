RELAYCORE_API_KEYS={"demo-key-change-me-32":{"tenant_id":"demo","role":"admin"},"viewer-key-change-me-32":{"tenant_id":"demo","role":"viewer"}}
RELAYCORE_DEMO_MODE=1
RELAYCORE_WORKERS=2
RELAYCORE_QUEUE_LIMIT=1000
RELAYCORE_RATE_LIMIT_PER_MINUTE=600
RELAYCORE_LEASE_SECONDS=4
# Production authentication: configure all values and set RELAYCORE_DEMO_MODE=0.
# The redirect URI must exactly match the OIDC provider's registered callback.
# RELAYCORE_OIDC_ISSUER=https://identity.example.com
# RELAYCORE_OIDC_CLIENT_ID=relaycore
# RELAYCORE_OIDC_CLIENT_SECRET=injected-from-your-secret-manager
# RELAYCORE_OIDC_REDIRECT_URI=https://relay.example.com/auth/callback
# Generate a random value of at least 32 characters for this signing secret.
# RELAYCORE_OIDC_STATE_SECRET=replace-with-at-least-32-random-characters
# RELAYCORE_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
# RELAYCORE_AUTH_SESSION_SECONDS=43200
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Inject from a secret manager; losing/changing this key makes stored webhook secrets unreadable.
# RELAYCORE_SECRET_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
