RELAYCORE_API_KEYS={"demo-key-change-me-32":{"tenant_id":"demo","role":"admin"},"viewer-key-change-me-32":{"tenant_id":"demo","role":"viewer"}}
RELAYCORE_DEMO_MODE=1
RELAYCORE_WORKERS=2
RELAYCORE_QUEUE_LIMIT=1000
RELAYCORE_RATE_LIMIT_PER_MINUTE=600
RELAYCORE_LEASE_SECONDS=4
# Production authentication: configure all values and set RELAYCORE_DEMO_MODE=0.
# The redirect URI must exactly match the OIDC provider's registered callback.
# RELAYCORE_OIDC_ISSUER=https://identity.example.com
# RELAYCORE_OIDC_CLIENT_ID=relaycore
# RELAYCORE_OIDC_CLIENT_SECRET=injected-from-your-secret-manager
# RELAYCORE_OIDC_REDIRECT_URI=https://relay.example.com/auth/callback
# Generate a random value of at least 32 characters for this signing secret.
# RELAYCORE_OIDC_STATE_SECRET=replace-with-at-least-32-random-characters
# RELAYCORE_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
# RELAYCORE_AUTH_SESSION_SECONDS=43200
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Inject from a secret manager; losing/changing this key makes stored webhook and workspace credentials unreadable.
# RELAYCORE_SECRET_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Production HTTP actions require explicit comma-separated DNS host allowlisting. No wildcards or custom ports.
# RELAYCORE_HTTP_ALLOWED_HOSTS=api.example.com,hooks.example.com
# Optional GitHub App integration. Set the App setup URL to the first URL and callback URL to the second.
# Configure its webhook URL as https://relay.example.com/integrations/github/webhook,
# subscribe to pull_request and installation events, and grant Pull requests: read-only.
# RELAYCORE_GITHUB_APP_SLUG=relaycore
# RELAYCORE_GITHUB_APP_ID=123456
# RELAYCORE_GITHUB_CLIENT_ID=Iv1...
# RELAYCORE_GITHUB_CLIENT_SECRET=injected-from-your-secret-manager
# Base64-encoded PEM GitHub App private key; inject from a secret manager.
# RELAYCORE_GITHUB_PRIVATE_KEY_B64=injected-from-your-secret-manager
# Use the same high-entropy secret configured in the GitHub App webhook settings.
# RELAYCORE_GITHUB_WEBHOOK_SECRET=injected-from-your-secret-manager
# RELAYCORE_GITHUB_SETUP_URL=https://relay.example.com/integrations/github/setup
# RELAYCORE_GITHUB_CALLBACK_URL=https://relay.example.com/integrations/github/callback
# Optional Slack App support. Register the callback as an OAuth Redirect URL and the events URL as its Request URL.
# Subscribe to app_mention and app_uninstalled; requested bot scopes are app_mentions:read and chat:write.
# RELAYCORE_SLACK_CLIENT_ID=123456.789012
# RELAYCORE_SLACK_CLIENT_SECRET=injected-from-your-secret-manager
# RELAYCORE_SLACK_APP_ID=A1234567890
# RELAYCORE_SLACK_SIGNING_SECRET=injected-from-your-secret-manager
# RELAYCORE_SLACK_CALLBACK_URL=https://relay.example.com/integrations/slack/callback
